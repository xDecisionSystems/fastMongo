# Core MongoDB settings
MONGO_HOST=127.0.0.1
MONGO_PORT=27017
MONGO_DB_NAME=fastmongo
MONGO_COLLECTION=app
MONGO_READER_PASSWORD=replace-with-strong-reader-password

# JWT settings used by the unified API
SECRET_KEY=replace-with-a-long-random-secret-at-least-32-chars
JWT_EXPIRATION_MINUTES=20
JWT_ISSUER=fastjwt-api
JWT_AUDIENCE=fastjwt-clients
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60

# API key for /post, /generate-token, and /validate-token
API_WRITE_KEY=replace-with-strong-api-write-key

# API key for /getrecs
API_READ_KEY=replace-with-strong-api-read-key

# Master key that can be used on all endpoints
API_MASTER_KEY=replace-with-strong-api-master-key

# Comma-separated allowed origins for browser access to /generate-token
# Example: https://app.example.com,https://admin.example.com
# Leave empty to require API key only
CORS_ORIGINS=

# Set to false to disable CORS-based access and require X-API-Key on all endpoints
ALLOW_CORS=true

# Comma-separated dotted paths within 'app' that /getrecs may query
GETRECS_ALLOWED_FIELDS=app.name,app.version

# Optional bind settings
API_BIND_HOST=0.0.0.0
API_BIND_PORT=8000

# Optional API base URL used by tests/test_api.sh
API_URL=http://localhost:8000
