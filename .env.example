# Core MongoDB settings
MONGO_HOST=127.0.0.1
MONGO_PORT=27017
MONGO_DB_NAME=fastmongo
MONGO_COLLECTION=app
MONGO_WRITER_USERNAME=writer
MONGO_WRITER_PASSWORD=replace-with-strong-writer-password
MONGO_READER_USERNAME=reader
MONGO_READER_PASSWORD=replace-with-strong-reader-password

# JWT settings used by the unified API
SECRET_KEY=replace-with-a-long-random-secret-at-least-32-chars
JWT_EXPIRATION_MINUTES=20
JWT_ISSUER=fastjwt-api
JWT_AUDIENCE=fastjwt-clients
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60

# API key for /keypost (write access)
WRITE_API_KEY=replace-with-strong-write-key

# API key for /getrecs and /exportdb (read/export access)
EXPORT_API_KEY=replace-with-strong-export-key

# API key for /generate-token (server-to-server access)
GENERATE_API_KEY=replace-with-strong-generate-token-key

# Comma-separated allowed origins for browser access to /generate-token
# Example: https://app.example.com,https://admin.example.com
# Leave empty to require API key only
CORS_ORIGINS=

# Comma-separated dotted paths within 'package' that /getrecs may query
GETRECS_ALLOWED_FIELDS=package.name,package.version

# Optional bind settings
API_BIND_HOST=0.0.0.0
API_BIND_PORT=8000

# Optional API base URL used by tests/test_api.sh
API_URL=http://localhost:8000
